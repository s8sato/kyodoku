FROM rust:1.76 AS builder
WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        cmake \
        pkg-config \
        libopus-dev \
    && rm -rf /var/lib/apt/lists/*

COPY Cargo.toml Cargo.lock ./
COPY bot/Cargo.toml bot/

# Pre-build dependencies to leverage Docker layer caching
RUN mkdir -p bot/src \
    && echo "fn main() {}" > bot/src/main.rs \
    && cargo build --release -p kyodoku-bot \
    && rm -rf bot/src

COPY . .
RUN cargo build --release -p kyodoku-bot

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends libopus0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /app/target/release/kyodoku-bot /usr/local/bin/kyodoku-bot
CMD ["kyodoku-bot"]
