# Discord application token and ID
DISCORD_TOKEN=
APPLICATION_ID=

# Database and cache connections (match infra/docker templates)
DATABASE_URL=postgres://postgres:postgres@db:5432/kyodoku
REDIS_URL=redis://redis:6379

# Voice session activation threshold (defaults to 1 participant)
READING_SESSION_ACTIVATION_THRESHOLD=1

# Voice channel cleanup delay in seconds (defaults to 60)
VOICE_CLEANUP_DELAY_SECONDS=60

# Comma-separated list of allowed Discord server (guild) IDs
# If empty, the bot will immediately leave every guild
ALLOWED_GUILD_IDS=

# Optional logging level
RUST_LOG=info
