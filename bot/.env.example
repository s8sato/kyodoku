# Discord application token and ID
DISCORD_TOKEN=
APPLICATION_ID=

# Database and cache connections (match infra/docker templates)
DATABASE_URL=postgres://postgres:postgres@db:5432/kyodoku
REDIS_URL=redis://redis:6379

# Channel budgets and limits (defaults keep the server safely under Discord caps)
MAX_SERVER_CHANNELS=480
TEXT_CHANNEL_TOTAL_BUDGET=430

# Voice channel cleanup delay in seconds (defaults to 60)
VOICE_CLEANUP_DELAY_SECONDS=60

# Optional dedicated command input channel
COMMAND_INPUT_CHANNEL_ID=

# Category IDs for organizing channels (required)
VOICE_CHANNEL_CATEGORY_ID=
TEXT_CHANNEL_CATEGORY_ID=
ARCHIVED_CHANNEL_CATEGORY_ID=

# Text channel layout
TEXT_CATEGORY_PREFIX=isbn-text
TEXT_CATEGORY_POSITION_BASE=50

# Text channel management
ACTIVE_TEXT_CHANNEL_CAPACITY=150
ARCHIVE_POLL_INTERVAL_SECONDS=86400
ARCHIVE_RETENTION_SECONDS=5184000
ARCHIVE_DELETE_NOTICE_LEAD_SECONDS=259200
TIME_ZONE=UTC

# Watchlist management
WATCHLIST_LIMIT=30

# Optional logging level
RUST_LOG=info
