# Discord application token and ID
DISCORD_TOKEN=
APPLICATION_ID=

# Database and cache connections (match infra/docker templates)
DATABASE_URL=postgres://postgres:postgres@db:5432/kyodoku
REDIS_URL=redis://redis:6379

# Voice channel cleanup delay in seconds (defaults to 60)
VOICE_CLEANUP_DELAY_SECONDS=60

# Optional dedicated command input channel
COMMAND_INPUT_CHANNEL_ID=

# Category IDs for organizing channels (required)
# Define TEXT_CATEGORY_1_ID and continue consecutively (e.g., TEXT_CATEGORY_2_ID, TEXT_CATEGORY_3_ID ...),
# stopping at the last configured value (minimum 1, maximum 9).
VOICE_CHANNEL_CATEGORY_ID=
TEXT_CATEGORY_1_ID=
TEXT_CATEGORY_2_ID=
TEXT_CATEGORY_3_ID=
TEXT_CATEGORY_4_ID=
TEXT_CATEGORY_5_ID=
TEXT_CATEGORY_6_ID=
TEXT_CATEGORY_7_ID=
TEXT_CATEGORY_8_ID=
TEXT_CATEGORY_9_ID=

# Text channel management
TEXT_ACTIVITY_EVAL_INTERVAL_SECONDS=86400
TEXT_ACTIVITY_PRESENCE_FACTOR=2.0
TEXT_CATEGORY_SWAP_COUNT=10
TEXT_CATEGORY_PRUNE_COUNT=10
TEXT_CATEGORY_CAPACITY=50
TIME_ZONE=UTC

# Watchlist management
WATCHLIST_LIMIT=30

# Optional logging level
RUST_LOG=info
